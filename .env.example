# ── Flask Core ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: leave blank (defaults to SQLite: recruitment_tracker.db)
# Cloud (Render / PythonAnywhere): set to your PostgreSQL or MySQL URL
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ── Google Gemini AI (Stage 2 parser – free tier) ────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# Leave blank to use offline regex fallback only (Stage 3)
GEMINI_API_KEY=

# ── Google Calendar API OAuth2 ───────────────────────────────────────────────
# Path to your OAuth2 credentials JSON downloaded from Google Cloud Console
# (OAuth 2.0 Client ID → Desktop or Web App → Download JSON)
GOOGLE_CREDENTIALS_PATH=credentials.json
# Token is auto-generated after first OAuth login; do not commit to git
GOOGLE_TOKEN_PATH=token.json
# Your Google Calendar ID (default: 'primary')
GOOGLE_CALENDAR_ID=primary

# ── Telegram Notifications (Optional) ────────────────────────────────────────
# Create a bot via @BotFather, get chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
